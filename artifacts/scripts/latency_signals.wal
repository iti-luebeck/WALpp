; Python WAL (SCA-WAL) counterpart of
;   wal --fast-values-signals signals/sailor_rtl_markers.txt <vcd>
; used for the "constant-time extraction" row of the performance table
; (see bench_ct_extraction.py). Prints one "index,signal,value" row per value
; change of each of the four marker signals.
;
; A signal is addressed as <trace-id>^<dotted hierarchy path>, the same in WAL++
; as in upstream WAL. The CLI option `-l` loads the first trace as t0.

(alias clk 't0^TOP.SAILORBlackBoxAdapter.clock)
(alias addr 't0^TOP.SAILORBlackBoxAdapter.busIO_dummyDataBus_address)
(alias isw 't0^TOP.SAILORBlackBoxAdapter.busIO_dummyDataBus_isWrite)
(alias vld 't0^TOP.SAILORBlackBoxAdapter.busIO_dummyDataBus_valid)

; One `whenever` per signal, so that a row is printed only when that signal
; changes. The same value-change events WAL++ emits, with two differences that
; matter if the outputs are diffed rather than timed: the first column here is
; INDEX, where `--fast-values-signals` writes the simulation timestamp (`TS`
; converts one to the other), and the rows come out grouped by signal, because
; this makes one pass per signal where the extraction path makes one interleaved
; pass over all of them.
(whenever (!= clk clk@-1) (printf "%d,0,%d\n" INDEX clk))
(whenever (!= addr addr@-1) (printf "%d,1,%d\n" INDEX addr))
(whenever (!= isw isw@-1) (printf "%d,2,%d\n" INDEX isw))
(whenever (!= vld vld@-1) (printf "%d,3,%d\n" INDEX vld))
