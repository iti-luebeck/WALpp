@PACKAGE_INIT@

# WAL++ links Threads, and ZLIB through the bundled fstapi, whose header includes
# <zlib.h> unconditionally. A consumer linking walpp needs both resolved before the
# target file is read: a static build exports fstapi, which names ZLIB::ZLIB.
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(ZLIB)

include("${CMAKE_CURRENT_LIST_DIR}/walppTargets.cmake")

check_required_components(walpp)
