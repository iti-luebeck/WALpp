; Calculate hamming-distance for signals in a specific module scope
; Usage: ./wal hd_module.wal -l trace.vcd
;
; Examples of scope prefixes:
;   "top"           - All signals in top module
;   "top^cpu"       - All signals in cpu submodule
;   "top^cpu^alu"   - All signals in alu sub-submodule

(print (hamming-distance-scope "TOP^TestDriver^testHarness^chiptop0^system^tile_prci_domain^element_reset_domain_rockettile^core"))
